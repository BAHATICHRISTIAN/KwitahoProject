<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanc">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_feuille_champ" />

    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:background="@drawable/fond_demarrage_fondu_bas" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="60dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <FrameLayout
            android:layout_width="170dp"
            android:layout_height="170dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                app:indicatorColor="@color/kw_primaire"
                app:indicatorSize="160dp"
                app:trackColor="@color/kw_teinte"
                app:trackThickness="8dp" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_feuille" />
        </FrameLayout>

        <TextView
            style="@style/Kw.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/analyse_titre" />

        <TextView
            style="@style/Kw.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/analyse_texte"
            android:textColor="@color/kw_texte_secondaire" />
    </LinearLayout>
</FrameLayout>
