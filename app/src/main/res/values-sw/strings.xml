    <string name="maladie_cbb_cause">Bakteria anayeenea kupitia vipandikizi vilivyoambukizwa, vifaa na maji.</string>
    <string name="maladie_cbb_prevention1">Tumia vipandikizi vyenye afya.</string>
    <string name="maladie_cbb_prevention2">Safisha vifaa baada ya kila kazi kwenye shamba lililoathirika.</string>
    <string name="maladie_cbb_prevention3">Haribu masalia yaliyoambukizwa na ubadilishe mazao.</string>
    <string name="maladie_cbb_conseil1">Epuka kufanya kazi shambani mimea ikiwa imelowa.</string>
    <string name="maladie_cbb_conseil2">Ugonjwa ukienea, wasiliana na fundi wa kilimo.</string>
