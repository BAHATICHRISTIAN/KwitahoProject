<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="invisible">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupe_puces"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/puce_tout"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filtre_tout"
                android:textSize="13sp"
                app:chipBackgroundColor="@color/blanc" />

            <com.google.android.material.chip.Chip
                android:id="@+id/puce_saine"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/filtre_saine"
                android:textSize="13sp"
                app:chipBackgroundColor="@color/blanc" />

            <com.google.android.material.chip.Chip
                android:id="@+id/puce_malade"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/filtre_malade"
                android:textSize="13sp"
                app:chipBackgroundColor="@color/blanc" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_historique"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:id="@+id/etat_vide"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/fond_cercle_teinte">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_historique"
                    app:tint="@color/kw_primaire" />
            </FrameLayout>

            <TextView
                style="@style/Kw.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/historique_vide_titre" />

            <TextView
                style="@style/Kw.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/historique_vide_texte"
                android:textColor="@color/kw_texte_secondaire" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scanner_vide"
                style="@style/Widget.Kw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/accueil_nouveau_diagnostic"
                app:icon="@drawable/ic_camera" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/squelette"
        layout="@layout/vue_squelette_liste" />
</FrameLayout>
